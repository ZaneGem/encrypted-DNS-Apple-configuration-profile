<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>DNSSettings</key>
			<dict>
				<key>AllowFailover</key>
				<false/>
				<key>DNSProtocol</key>
				<string>TLS</string>
				<key>ServerAddresses</key>
				<array>
					<string>223.5.5.5</string>
					<string>223.6.6.6</string>
					<string>2400:3200::1</string>
					<string>2400:3200:baba::1</string>
				</array>
				<key>ServerName</key>
				<string>dns.alidns.com</string>
			</dict>
			<key>PayloadDescription</key>
			<string>阿里云 DoT 加密 DNS；保留 IPv4/IPv6 服务器地址及 TLS 证书验证。不按网络接口、SSID 或域名限制，启用时用于系统默认 DNS 解析。AllowFailover=false：在支持该字段的系统上禁止回退到默认系统 DNS，加密解析不可用时相关新 DNS 查询失败。Apple 系统例外及 VPN DNS 优先级仍适用；不提供禁止用户停用功能。</string>
			<key>PayloadDisplayName</key>
			<string>阿里云 DoT 加密 DNS（全网络）</string>
			<key>PayloadIdentifier</key>
			<string>org.encrypted-dns.alidns.dot.strict.settings.e92b531d-bd3e-4d1d-ab4e-501893759c8a</string>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadUUID</key>
			<string>E92B531D-BD3E-4D1D-AB4E-501893759C8A</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>OnDemandRules</key>
			<array>
				<dict>
					<key>Action</key>
					<string>Connect</string>
				</dict>
			</array>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>阿里云 DoT 加密 DNS；保留 IPv4/IPv6 服务器地址及 TLS 证书验证。不按网络接口、SSID 或域名限制，启用时用于系统默认 DNS 解析。AllowFailover=false：在支持该字段的系统上禁止回退到默认系统 DNS，加密解析不可用时相关新 DNS 查询失败。Apple 系统例外及 VPN DNS 优先级仍适用；不提供禁止用户停用功能。</string>
	<key>PayloadDisplayName</key>
	<string>阿里云 DoT · 全网络 · 禁止回退</string>
	<key>PayloadIdentifier</key>
	<string>org.encrypted-dns.alidns.dot.strict.profile.ed7f5747-da03-4ad1-8188-fb9770737861</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>ED7F5747-DA03-4AD1-8188-FB9770737861</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
